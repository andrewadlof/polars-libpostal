 static address_parser_t *parser = NULL;
 
+// Parsing mutates scratch buffers (the address parser context, and for the
+// CRF model the CRF context and Viterbi array). Each thread gets its own set
+// so address_parser_parse can be called concurrently. The averaged perceptron
+// model keeps its scratch inside the model, so it is serialized by a mutex.
+static pthread_key_t scratch_key;
+static pthread_once_t scratch_key_once = PTHREAD_ONCE_INIT;
+static pthread_mutex_t shared_scratch_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static void scratch_key_destructor(void *value) {
+    address_parser_scratch_destroy((address_parser_scratch_t *)value);
+}
+
+static void scratch_key_create(void) {
+    pthread_key_create(&scratch_key, scratch_key_destructor);
+}
+
+static address_parser_scratch_t *get_thread_scratch(address_parser_t *self) {
+    pthread_once(&scratch_key_once, scratch_key_create);
+
+    address_parser_scratch_t *scratch = pthread_getspecific(scratch_key);
+    if (scratch != NULL && scratch->parser == self) {
+        return scratch;
+    }
+
+    // First use in this thread, or the parser was torn down and set up again
+    address_parser_scratch_destroy(scratch);
+    scratch = address_parser_scratch_new(self);
+    pthread_setspecific(scratch_key, scratch);
+    return scratch;
+}
