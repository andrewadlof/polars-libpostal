+    if (parser->model_type != ADDRESS_PARSER_TYPE_CRF) {
+        // The perceptron keeps its scratch space in the model: one caller at a time
+        address_parser_scratch_t shared = { .parser = parser, .context = parser->context, .crf = NULL };
+        pthread_mutex_lock(&shared_scratch_mutex);
+        libpostal_address_parser_response_t *response = address_parser_parse_scratch(parser, &shared, address, language, country);
+        pthread_mutex_unlock(&shared_scratch_mutex);
+        return response;
+    }
+
+    address_parser_scratch_t *scratch = get_thread_scratch(parser);
+    if (scratch == NULL) {
+        log_error("could not allocate parser scratch space\n");
+        return NULL;
+    }
+    return address_parser_parse_scratch(parser, scratch, address, language, country);
+}
